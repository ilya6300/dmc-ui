{
  "name": "@dmc/ui",
  "version": "1.0.0",
  "description": "DMC CC-V4 UI components and Storybook",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles/dmc-ui.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "vite build",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project unit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "jsdom": "^29.1.1",
    "playwright": "latest",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "vite": "^6.0.3",
    "vitest": "latest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
